rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if request is from authenticated user
    function isAuth() {
      return request.auth != null;
    }

    // Helper: check if request user matches document owner
    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // Helper: check if user is a guardian of the protected person
    function isGuardianOf(protectedPersonId) {
      return isAuth() && exists(/databases/$(database)/documents/guardian_links/$(request.auth.uid + '_' + protectedPersonId))
        && get(/databases/$(database)/documents/guardian_links/$(request.auth.uid + '_' + protectedPersonId)).data.status == 'active';
    }

    // Users — read/write own profile only, with field validation
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId)
        && request.resource.data.displayName is string
        && request.resource.data.role in ['protected', 'guardian']
        && request.resource.data.phone is string;
    }

    // Guardian links — read if you are either side, create only if you are one party
    match /guardian_links/{linkId} {
      allow read: if isAuth() && (
        resource.data.guardianId == request.auth.uid ||
        resource.data.protectedPersonId == request.auth.uid
      );
      allow create: if isAuth() && (
        request.resource.data.guardianId == request.auth.uid ||
        request.resource.data.protectedPersonId == request.auth.uid
      ) && request.resource.data.status in ['pending', 'active']
        && request.resource.data.guardianId is string
        && request.resource.data.protectedPersonId is string;
      allow update: if isAuth() && (
        resource.data.guardianId == request.auth.uid ||
        resource.data.protectedPersonId == request.auth.uid
      );
      allow delete: if isAuth() && (
        resource.data.guardianId == request.auth.uid ||
        resource.data.protectedPersonId == request.auth.uid
      );
    }

    // SOS events — read if authenticated, write via Cloud Functions only
    match /sos_events/{sosId} {
      allow read: if isAuth();
      allow write: if false; // Server-side only via admin SDK
    }

    // Safe zones — owner only with validation on create
    match /safe_zones/{zoneId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // Duty schedules — read if authenticated, write server-side only
    match /duty_schedules/{scheduleId} {
      allow read: if isAuth();
      allow write: if false; // Server-side only
    }

    // Invites — creator validation, acceptor can update pending invites
    match /invites/{inviteId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.code is string;
      allow update: if isAuth()
        && (resource.data.createdBy == request.auth.uid || resource.data.status == 'pending');
    }

    // Device tokens — own tokens only (fixed: was allowing any auth user)
    match /device_tokens/{tokenId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // Timeline entries — own entries only
    match /timeline_entries/{entryId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow write: if false; // Server-side only
    }

    // Family posts — author can edit/delete, family members can read
    match /family_posts/{postId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuth() && resource.data.authorId == request.auth.uid;
      allow delete: if isAuth() && resource.data.authorId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if isAuth();
        allow create: if isAuth() && request.resource.data.authorId == request.auth.uid;
      }
    }

    // Evidence holds — read if authenticated, write server-side only
    match /evidence_holds/{holdId} {
      allow read: if isAuth();
      allow write: if false; // Server-side only
    }

    // Integrity proofs — read only
    match /integrity_proofs/{date} {
      allow read: if isAuth();
      allow write: if false; // Server-side only
    }

    // Subscriptions — read own only, write server-side
    match /subscriptions/{userId} {
      allow read: if isOwner(userId);
      allow write: if false; // Server-side only
    }

    // Crash reports — create own only
    match /crash_reports/{reportId} {
      allow create: if isAuth();
      allow read, update, delete: if false;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

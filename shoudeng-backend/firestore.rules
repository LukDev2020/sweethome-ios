rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if request is from authenticated user
    function isAuth() {
      return request.auth != null;
    }

    // Helper: check if request user matches document owner
    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // Helper: check if user is a guardian of the protected person
    function isGuardianOf(protectedPersonId) {
      return isAuth() && exists(/databases/$(database)/documents/guardian_links/$(request.auth.uid + '_' + protectedPersonId))
        && get(/databases/$(database)/documents/guardian_links/$(request.auth.uid + '_' + protectedPersonId)).data.status == 'active';
    }

    // Users — read/write own profile only, with field validation
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId)
        && request.resource.data.displayName is string
        && request.resource.data.role in ['protected', 'guardian']
        && request.resource.data.phone is string;
    }

    // Guardian links — read if you are either side, create only if you are one party
    match /guardian_links/{linkId} {
      allow read: if isAuth() && (
        resource.data.guardianId == request.auth.uid ||
        resource.data.protectedPersonId == request.auth.uid
      );
      allow create: if false; // Server-side only via admin SDK (invite-accept flow)
      allow update: if isAuth() && (
        resource.data.guardianId == request.auth.uid ||
        resource.data.protectedPersonId == request.auth.uid
      );
      allow delete: if isAuth() && (
        resource.data.guardianId == request.auth.uid ||
        resource.data.protectedPersonId == request.auth.uid
      );
    }

    // SOS events — read if protected person or linked guardian, write server-side only
    match /sos_events/{sosId} {
      allow read: if isAuth() && (
        resource.data.protectedPersonId == request.auth.uid ||
        isGuardianOf(resource.data.protectedPersonId)
      );
      allow write: if false; // Server-side only via admin SDK
    }

    // Safe zones — owner only with validation on create
    match /safe_zones/{zoneId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // Duty schedules — server-side only (app reads via API)
    match /duty_schedules/{scheduleId} {
      allow read: if false;
      allow write: if false; // Server-side only
    }

    // Invites — only creator can read their own invites
    match /invites/{inviteId} {
      allow read: if isAuth() && resource.data.createdBy == request.auth.uid;
      allow create: if isAuth()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.code is string;
      allow update: if isAuth()
        && (resource.data.createdBy == request.auth.uid || resource.data.status == 'pending');
    }

    // Device tokens — own tokens only (fixed: was allowing any auth user)
    match /device_tokens/{tokenId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // Timeline entries — own entries only
    match /timeline_entries/{entryId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow write: if false; // Server-side only
    }

    // Family posts — author or linked family members can read
    match /family_posts/{postId} {
      allow read: if isAuth() && (
        resource.data.authorId == request.auth.uid ||
        isGuardianOf(resource.data.authorId) ||
        exists(/databases/$(database)/documents/guardian_links/$(resource.data.authorId + '_' + request.auth.uid))
          && get(/databases/$(database)/documents/guardian_links/$(resource.data.authorId + '_' + request.auth.uid)).data.status == 'active'
      );
      allow create: if isAuth() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuth() && resource.data.authorId == request.auth.uid;
      allow delete: if isAuth() && resource.data.authorId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if isAuth() && (
          get(/databases/$(database)/documents/family_posts/$(postId)).data.authorId == request.auth.uid ||
          isGuardianOf(get(/databases/$(database)/documents/family_posts/$(postId)).data.authorId) ||
          exists(/databases/$(database)/documents/guardian_links/$(get(/databases/$(database)/documents/family_posts/$(postId)).data.authorId + '_' + request.auth.uid))
            && get(/databases/$(database)/documents/guardian_links/$(get(/databases/$(database)/documents/family_posts/$(postId)).data.authorId + '_' + request.auth.uid)).data.status == 'active'
        );
        allow create: if isAuth() && request.resource.data.authorId == request.auth.uid;
      }
    }

    // Evidence holds — server-side only
    match /evidence_holds/{holdId} {
      allow read: if false;
      allow write: if false; // Server-side only
    }

    // Integrity proofs — read only
    match /integrity_proofs/{date} {
      allow read: if isAuth();
      allow write: if false; // Server-side only
    }

    // Subscriptions — read own only, write server-side
    match /subscriptions/{userId} {
      allow read: if isOwner(userId);
      allow write: if false; // Server-side only
    }

    // Crash reports — create own only
    match /crash_reports/{reportId} {
      allow create: if isAuth();
      allow read, update, delete: if false;
    }

    // Medical cards — owner read/write, guardians can read
    match /medical_cards/{userId} {
      allow read: if isOwner(userId) || isGuardianOf(userId);
      allow write: if isOwner(userId);
    }

    // Medical card shares — public read by token, create by owner
    match /medical_card_shares/{tokenId} {
      allow read: if true; // Public access by share token
      allow create: if isAuth();
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // Emergency contacts — owner only
    match /emergency_contacts/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Organizations — members can read, admin can write
    match /organizations/{orgId} {
      allow read: if isAuth();
      allow write: if false; // Server-side only
    }

    // Location history — owner only, server writes
    match /location_history/{docId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow write: if false; // Server-side only
    }

    // Trips — owner read/write, linked guardians can read
    match /trips/{tripId} {
      allow read: if isAuth() && (
        resource.data.userId == request.auth.uid ||
        isGuardianOf(resource.data.userId)
      );
      allow write: if false; // Server-side only

      match /points/{pointId} {
        allow read: if isAuth() && (
          get(/databases/$(database)/documents/trips/$(tripId)).data.userId == request.auth.uid ||
          isGuardianOf(get(/databases/$(database)/documents/trips/$(tripId)).data.userId)
        );
        allow write: if false; // Server-side only
      }
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

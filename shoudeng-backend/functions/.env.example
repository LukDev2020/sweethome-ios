# JWT secret for signing access/refresh tokens
# Generate with: openssl rand -hex 32
# In production, use Firebase Secrets: firebase functions:secrets:set JWT_SECRET
JWT_SECRET=your-secret-here

# --- App Store (in-app subscriptions) ---
# Numeric Apple ID of the app: App Store Connect → your app → App Information → "Apple ID".
# TODO(owner): required before App Store release. Without it Production transactions still
# verify, but Production App Store Server Notifications are rejected (401) and retried by Apple.
APPLE_APP_ID=
# Transactions are verified against Production first, then Sandbox (TestFlight, App Review,
# sandbox testers). Set to "false" only to refuse Sandbox purchases entirely.
# APPLE_ALLOW_SANDBOX=true

# --- Twilio (SOS SMS + voice calls) — see docs/ops/SECRETS.md ---
# TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN / GOOGLE_MAPS_API_KEY are Secret Manager secrets
# (firebase functions:secrets:set …), never .env values.
# Twilio number in E.164: caller ID for SOS calls, and SMS sender unless TWILIO_SMS_FROM is set.
TWILIO_FROM_NUMBER=
# Optional SMS sender (number or alphanumeric sender ID). Empty = TWILIO_FROM_NUMBER.
TWILIO_SMS_FROM=

# "true" only once Apple grants the Critical Alerts entitlement.
CRITICAL_ALERTS_ENABLED=false
# Public URL of the api function if Twilio reaches it through another host (custom domain).
# Empty = https://us-central1-<project>.cloudfunctions.net/api
PUBLIC_API_BASE_URL=

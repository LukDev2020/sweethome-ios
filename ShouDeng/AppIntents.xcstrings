{
  "sourceLanguage": "en",
  "strings": {
    "intent.endShift.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ends your Beaconify rider shift."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束你的守灯骑手班次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結束你的守燈騎手班次。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Termine votre service Beaconify."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Beaconify のライダー勤務を終了します。"
          }
        }
      }
    },
    "intent.endShift.done": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift ended. Get home safe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已下班，路上注意安全。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已下班，路上注意安全。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Service terminé. Rentrez bien."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "勤務を終了しました。気をつけて帰ってください。"
          }
        }
      }
    },
    "intent.endShift.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End shift"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下班"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下班"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminer le service"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "勤務終了"
          }
        }
      }
    },
    "intent.openAppFirst": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Beaconify first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先打开守灯。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先打開守燈。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez d'abord Beaconify."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に Beaconify を開いてください。"
          }
        }
      }
    },
    "intent.sos.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens Beaconify at the SOS countdown."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开守灯并进入求助倒计时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開守燈並進入求助倒數。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Beaconify sur le compte à rebours SOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Beaconify を開いて SOS のカウントダウンを表示します。"
          }
        }
      }
    },
    "intent.sos.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Beaconify SOS"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "守灯紧急求助"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "守燈緊急求助"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SOS Beaconify"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Beaconify SOS"
          }
        }
      }
    },
    "intent.startShift.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts a Beaconify rider shift and shares your location with your crew."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始守灯骑手班次，并与车队共享你的位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始守燈騎手班次，並與車隊共享你的位置。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarre un service Beaconify et partage votre position avec votre équipe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Beaconify のライダー勤務を開始し、クルーと位置を共有します。"
          }
        }
      }
    },
    "intent.startShift.done": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift started. Your crew can see you."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已上班，车队能看到你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已上班，車隊能看到你。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Service commencé. Votre équipe vous voit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "勤務を開始しました。クルーにあなたの位置が見えます。"
          }
        }
      }
    },

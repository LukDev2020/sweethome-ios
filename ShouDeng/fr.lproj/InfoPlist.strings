CFBundleDisplayName = "Beaconify";
CFBundleName = "Beaconify";

/* Localisation — Toujours */
NSLocationAlwaysAndWhenInUseUsageDescription = "Beaconify partage votre position avec les membres de la famille que vous choisissez, afin qu'ils puissent vous joindre en cas d'urgence. La position est aussi utilisee pour les notifications de zone securisee. Le partage ne commence qu'apres votre acceptation dans l'application.";

/* Localisation — En cours d'utilisation */
NSLocationWhenInUseUsageDescription = "Beaconify utilise votre position pour afficher ou vous etes sur la carte et pour l'envoyer aux membres de votre famille choisis lors d'un SOS. Utilise uniquement apres votre consentement dans l'application.";

/* Capteurs de mouvement */
NSMotionUsageDescription = "Beaconify utilise les capteurs de mouvement pour détecter une chute possible lorsque l'application est ouverte. En cas de chute, vous avez 60 secondes pour annuler l'alerte avant que votre famille soit prévenue.";

/* Face ID */
NSFaceIDUsageDescription = "Beaconify utilise Face ID pour verifier votre identite et proteger l'acces a vos donnees de securite familiale.";

/* Microphone */
NSMicrophoneUsageDescription = "Si vous activez le SOS vocal ou la détection de cris, Beaconify écoute votre phrase de SOS ou un cri pour envoyer votre SOS sans les mains. L’écoute se fait sur votre appareil ; aucun son n’est enregistré ni envoyé.";

/* Phototheque */
NSPhotoLibraryUsageDescription = "Partagez des photos avec les membres de votre cercle familial. Les photos ne sont visibles que par les personnes dans votre relation de tutelle.";

/* Contacts */
NSContactsUsageDescription = "Choisissez une personne dans vos contacts comme contact d’urgence. Seule la personne choisie (nom et numéro) est enregistrée dans votre compte, pour que vos SMS de SOS puissent la joindre.";
NSBluetoothAlwaysUsageDescription = "Beaconify se connecte à votre bouton d'alerte et à vos balises Bluetooth pour déclencher un SOS et détecter un objet oublié. Le Bluetooth n'est utilisé qu'après l'appairage d'un appareil dans Réglages.";
NSSpeechRecognitionUsageDescription = "Le SOS vocal reconnaît une phrase comme « au secours » ou « help » et envoie votre SOS sans les mains. La reconnaissance se fait sur votre appareil ; si votre téléphone ne le permet pas, le SOS vocal reste désactivé.";

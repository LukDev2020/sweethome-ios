/* Feature disclosures (first use) */
"disclosure.sos.title" = "Avant d'envoyer un SOS";
"disclosure.sos.body" = "Un SOS prévient les contacts que vous avez choisis.\n\nSi vous êtes en danger, appelez aussi le %@. Lantern Care n'appelle pas les secours à votre place.";
"disclosure.location.title" = "Partager votre position";
"disclosure.location.body" = "Une fois activé, les proches que vous avez choisis voient la dernière position que vous avez envoyée.\n\nChaque position est horodatée : ils voient où vous étiez il y a quelques minutes, pas un suivi en direct.";
"disclosure.trajectory.title" = "Historique des trajets";
"disclosure.trajectory.body" = "Une fois activé, Lantern Care conserve vos trajets des 7 derniers jours pour aider vos proches à savoir où vous avez pu aller en cas d'urgence.\n\nEn temps normal, vos proches ne voient que votre dernière position, pas votre trajet. Vos deux dernières heures de trajet ne leur deviennent visibles que si vous envoyez un SOS.";
"disclosure.fallDetection.title" = "Détection de chute";
"disclosure.fallDetection.body" = "La détection de chute est une estimation à partir des capteurs du téléphone. Ce n'est pas un dispositif médical et elle n'est certifiée par aucune autorité.\n\nElle peut manquer une vraie chute ou se déclencher lors de gestes du quotidien. Ne vous y fiez pas comme seule mesure de sécurité.";
"disclosure.emergencyAudio.title" = "Enregistrement sonore pendant un SOS";
"disclosure.emergencyAudio.body" = "Certains pays et régions exigent le consentement de toutes les personnes présentes pour un enregistrement. Renseignez-vous sur la loi locale avant d'activer cette option.\n\nL'enregistrement n'a lieu que pendant un SOS et s'arrête automatiquement à sa fin.";
"disclosure.autoVoiceCall.title" = "Appels vocaux automatiques";
"disclosure.autoVoiceCall.body" = "Si personne ne répond à la notification ni au SMS, le système appelle vos contacts l'un après l'autre jusqu'à ce que quelqu'un décroche et confirme en appuyant sur une touche.\n\nC'est pour la nuit : un appel réveille plus sûrement qu'une notification.";
"disclosure.button.notNow" = "Pas maintenant";
"disclosure.button.enable" = "Activer";
"disclosure.button.sendSOS" = "J'ai compris, envoyer le SOS";
"disclosure.button.understood" = "J'ai compris";

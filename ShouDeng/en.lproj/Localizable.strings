/* Feature disclosures (first use) */
"disclosure.sos.title" = "Before you send an SOS";
"disclosure.sos.body" = "An SOS alerts the contacts you chose.\n\nIf you are in danger, also call %@. Lantern Care does not call emergency services for you.";
"disclosure.location.title" = "Share your location";
"disclosure.location.body" = "When on, the family members you chose can see the last location you reported.\n\nEvery location carries its time, so they see where you were a few minutes ago — not a live follow.";
"disclosure.trajectory.title" = "Route history";
"disclosure.trajectory.body" = "When on, Lantern Care keeps the routes you travelled in the last 7 days, to help your family work out where you may have gone in an emergency.\n\nNormally your family sees only your latest location, not your route. Your last two hours of route become visible to them only when you send an SOS.";
"disclosure.fallDetection.title" = "Fall detection";
"disclosure.fallDetection.body" = "Fall detection is an estimate from your phone's sensors. It is not a medical device and is not certified by any regulator.\n\nIt can miss a real fall and can be triggered by everyday movements. Don't rely on it as your only safety measure.";
"disclosure.emergencyAudio.title" = "Recording sound during an SOS";
"disclosure.emergencyAudio.body" = "Some countries and regions require everyone present to consent to a recording. Check the law where you are before turning this on.\n\nRecording happens only during an SOS and stops automatically when it ends.";
"disclosure.autoVoiceCall.title" = "Automatic voice calls";
"disclosure.autoVoiceCall.body" = "If nobody responds to the notification and text message, the system calls your contacts one after another until someone answers and presses a key to confirm.\n\nThis is for the middle of the night — a call wakes people more reliably than a notification.";
"disclosure.button.notNow" = "Not now";
"disclosure.button.enable" = "Turn on";
"disclosure.button.sendSOS" = "I understand, send SOS";
"disclosure.button.understood" = "Got it";
"home.arrivalReport" = "Arrival Report";


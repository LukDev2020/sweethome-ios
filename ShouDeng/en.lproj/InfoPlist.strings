CFBundleDisplayName = "Beaconify";
CFBundleName = "Beaconify";

/* Location — Always */
NSLocationAlwaysAndWhenInUseUsageDescription = "Beaconify shares your location with family members you choose, so they can reach you in an emergency. Location is also used for safe-zone notifications. Sharing begins only after you accept the in-app consent prompt.";

/* Location — When In Use */
NSLocationWhenInUseUsageDescription = "Beaconify uses your location to show where you are on the map and to send your position to chosen family members during an SOS. Used only after you accept in-app consent.";

/* Motion / Accelerometer */
NSMotionUsageDescription = "Beaconify uses motion sensors to detect a possible fall while the app is open. If a fall is detected, you have 60 seconds to dismiss the alert before your family is notified.";

/* Face ID */
NSFaceIDUsageDescription = "Beaconify uses Face ID to verify your identity and protect access to your family safety data.";

/* Microphone */
NSMicrophoneUsageDescription = "If you turn on voice SOS or distress-sound detection, Beaconify listens for your SOS phrase or a scream so it can send your SOS hands-free. Listening happens on your device; audio is not recorded or uploaded.";

/* Photo Library */
NSPhotoLibraryUsageDescription = "Share photos with family members in your guardian circle. Photos are visible only to people in your guardianship relationship.";

/* Contacts */
NSContactsUsageDescription = "Pick someone from your contacts to add as an emergency contact. Only the person you choose (name and phone number) is saved to your account, so your SOS texts can reach them.";
NSBluetoothAlwaysUsageDescription = "Beaconify connects to your Bluetooth panic button and tracking tags to trigger SOS alerts and detect separation. Bluetooth is used only after you pair a device in Settings.";
NSSpeechRecognitionUsageDescription = "Voice SOS listens for a phrase such as “help” or “救命” and sends your SOS hands-free. Recognition runs on your device; where your phone can’t do that, voice SOS stays off.";

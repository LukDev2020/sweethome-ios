CFBundleDisplayName = "Beaconify";
CFBundleName = "Beaconify";

/* Location — Always */
NSLocationAlwaysAndWhenInUseUsageDescription = "Beaconifyは、緊急時にご家族があなたに駆けつけられるよう、あなたが選んだご家族と位置情報を共有します。位置情報は安全エリアの通知にも使用されます。共有はアプリ内の同意画面で同意した後にのみ開始されます。";

/* Location — When In Use */
NSLocationWhenInUseUsageDescription = "Beaconifyは、地図上に現在地を表示するため、またSOSの発信中にあなたが選んだご家族へ現在地を送信するために位置情報を使用します。アプリ内で同意した後にのみ使用されます。";

/* Motion / Accelerometer */
NSMotionUsageDescription = "Beaconifyは、アプリの使用中にモーションセンサーを使って転倒の可能性を検知します。転倒が検知された場合、ご家族に通知される前に60秒以内であればアラートを解除できます。";

/* Face ID */
NSFaceIDUsageDescription = "Beaconifyは、本人確認を行い、ご家族の安全に関するデータへのアクセスを保護するためにFace IDを使用します。";

/* Microphone */
NSMicrophoneUsageDescription = "音声SOSまたは悲鳴の検知をオンにすると、Beaconifyが合言葉や悲鳴を聞き取り、手を使わずにSOSを発信します。聞き取りはデバイス上で行われ、音声は録音もアップロードもされません。";

/* Photo Library */
NSPhotoLibraryUsageDescription = "見守りグループのご家族と写真を共有できます。写真は見守り関係にある人だけが閲覧できます。";

/* Contacts */
NSContactsUsageDescription = "連絡先から緊急連絡先にする人を選びます。選んだ人（名前と電話番号）だけがアカウントに保存され、SOSのSMSが届くようになります。";
NSBluetoothAlwaysUsageDescription = "Beaconifyは、Bluetooth対応の緊急ボタンや追跡タグに接続し、SOSアラートの発信や離れたことの検知を行います。Bluetoothは「設定」でデバイスをペアリングした後にのみ使用されます。";
NSSpeechRecognitionUsageDescription = "音声SOSは「助けて」や「help」などの言葉を聞き取り、手を使わずにSOSを発信します。認識はデバイス上で行われ、対応していない端末では音声SOSはオフのままです。";

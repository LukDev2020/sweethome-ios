CFBundleDisplayName = "守灯";
CFBundleName = "守灯";

/* 位置 — 始终 */
NSLocationAlwaysAndWhenInUseUsageDescription = "守灯会将你的位置分享给你选择的家人，以便在紧急情况下联系你。位置信息也用于安全区进出通知。仅在你接受应用内同意提示后才开始共享。";

/* 位置 — 使用时 */
NSLocationWhenInUseUsageDescription = "守灯使用你的位置在地图上显示你所在的位置，并在紧急求助时将位置发送给你选择的家人。仅在你接受应用内同意后使用。";

/* 运动传感器 */
NSMotionUsageDescription = "守灯在应用打开时使用运动传感器检测可能的跌倒。检测到后你有 60 秒时间取消警报，之后才会通知你的家人。";

/* 面容 ID */
NSFaceIDUsageDescription = "守灯使用面容 ID 验证你的身份，保护家庭安全数据的访问。";

/* 麦克风 */
NSMicrophoneUsageDescription = "开启语音求助或呼救声识别后，守灯会监听你的求助口令或尖叫声，以便免手动发出 SOS。识别在你的设备上完成，不会录音或上传。";

/* 照片图库 */
NSPhotoLibraryUsageDescription = "与守护圈内的家人分享照片。照片仅对你的守护关系内的人可见。";

/* 通讯录 */
NSContactsUsageDescription = "从通讯录中选择一位联系人作为紧急联络人。只会把你选中的这一位（姓名和电话）保存到你的账户，以便求助短信能联系到对方。";
NSBluetoothAlwaysUsageDescription = "守灯会连接你的蓝牙紧急按钮和防丢标签，用于发出 SOS 和提醒物品遗落。只有在设置中配对设备后才会使用蓝牙。";
NSSpeechRecognitionUsageDescription = "语音求助会识别「救命」或 “help” 等口令，免手动发出 SOS。识别在你的设备上完成；设备不支持时，语音求助保持关闭。";

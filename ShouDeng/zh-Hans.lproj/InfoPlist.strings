CFBundleDisplayName = "守灯";
CFBundleName = "守灯";

/* 位置 — 始终 */
NSLocationAlwaysAndWhenInUseUsageDescription = "守灯会将你的位置分享给你选择的家人，以便在紧急情况下联系你。位置信息也用于安全区进出通知。仅在你接受应用内同意提示后才开始共享。";

/* 位置 — 使用时 */
NSLocationWhenInUseUsageDescription = "守灯使用你的位置在地图上显示你所在的位置，并在紧急求助时将位置发送给你选择的家人。仅在你接受应用内同意后使用。";

/* 运动传感器 */
NSMotionUsageDescription = "守灯使用加速计检测可能的跌倒。检测到后你有 60 秒时间取消警报，之后才会通知你的家人。此功能仅在你在应用中开启跌倒检测后才会启用。";

/* 面容 ID */
NSFaceIDUsageDescription = "守灯使用面容 ID 验证你的身份，保护家庭安全数据的访问。";

/* 麦克风 */
NSMicrophoneUsageDescription = "在紧急求助期间，麦克风可能会录制环境音以帮助你选择的家人判断现场情况。仅在你开启此选项且当地法律允许时才会录制。";

/* 照片图库 */
NSPhotoLibraryUsageDescription = "与守护圈内的家人分享照片。照片仅对你的守护关系内的人可见。";

/* 通讯录 */
NSContactsUsageDescription = "访问通讯录以快速添加紧急联络人信息。联系人数据不会上传到我们的服务器。";

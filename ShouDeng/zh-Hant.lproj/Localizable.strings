/* Feature disclosures (first use) */
"disclosure.sos.title" = "發出求助前請確認";
"disclosure.sos.body" = "求助將通知你指定的聯絡人。\n\n如果情況危急，請同時撥打 %@。守燈不會代你撥打急救電話。";
"disclosure.location.title" = "共享你的位置";
"disclosure.location.body" = "開啟後，你選擇的家人可以看到你最近一次上報的位置。\n\n位置每次上報都帶有時間，他們看到的是「幾分鐘前你在哪」，不是持續的跟隨。";
"disclosure.trajectory.title" = "軌跡記錄";
"disclosure.trajectory.body" = "開啟後，守燈會儲存你最近 7 天走過的路線，用於在緊急情況下幫助家人判斷你可能去了哪裡。\n\n日常情況下家人只能看到你最近的位置，看不到路線。只有在你觸發求助時，最近兩小時的軌跡才會對他們可見。";
"disclosure.fallDetection.title" = "跌倒檢測";
"disclosure.fallDetection.body" = "跌倒檢測基於手機感測器估算，不是醫療裝置，未經任何監管機構認證。\n\n它可能漏掉真實的跌倒，也可能被日常動作誤觸發。請不要將其作為唯一的安全手段。";
"disclosure.emergencyAudio.title" = "求助時的環境錄音";
"disclosure.emergencyAudio.body" = "部分國家和地區要求錄音需經所有在場者同意。請了解你所在地的法律後再開啟。\n\n錄音僅在求助期間進行，結束後自動停止。";
"disclosure.autoVoiceCall.title" = "自動語音外呼";
"disclosure.autoVoiceCall.body" = "如果推送和簡訊都沒人回應，系統會依次撥打你的聯絡人電話，直到有人接聽並按鍵確認。\n\n這是為了應對深夜——電話比推送更容易叫醒人。";
